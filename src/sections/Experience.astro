---
import SplitTitle from '../components/SplitTitle.astro';
import Reveal from '../components/Reveal';
import StoryImage from '../components/StoryImage';
---

<!-- Experience — golden hour: media leads, generous senior-friendly copy -->
<section
  id="experience"
  class="story-section ritual-phase-golden relative overflow-hidden bg-night"
  data-ritual-phase="golden"
>
  <div class="grid lg:grid-cols-2">
    <div class="relative min-h-[60vh] lg:min-h-[90vh]">
      <StoryImage
        client:visible
        src="/images/gallery/10.jpg"
        className="absolute inset-0 h-full w-full"
        fromScale={1.1}
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-night/30 via-sunset-orange/10 to-night/60 lg:bg-gradient-to-r lg:from-transparent lg:to-night/80"
        aria-hidden="true"
      />
    </div>
    <div class="relative z-10 flex flex-col justify-center px-6 py-20 md:px-12 lg:px-16 lg:py-28">
      <Reveal client:visible y={22}>
        <SplitTitle base="THE" script="Experience" />
      </Reveal>
      <Reveal client:visible delay={0.1} y={18} className="mt-10 max-w-lg space-y-5">
        <p class="text-on-photo text-on-photo-lg font-light">
          Every corner of Horizons is composed for atmosphere: soft ocean breezes, candlelight, and a soundscape that moves from sunset acoustic to midnight energy.
        </p>
        <p class="text-on-photo text-on-photo-lg font-light">
          Reserve your table by the water, settle into a private cabana, or let our hosts craft an evening that belongs only to you.
        </p>
      </Reveal>
    </div>
  </div>
</section>
