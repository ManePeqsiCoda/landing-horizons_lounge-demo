---
import SectionWrapper from '../components/SectionWrapper.astro';
---

<!-- 3. The Experience — golden hour -->
<SectionWrapper
  id="experience"
  base="THE"
  script="Experience"
  phase="golden"
  layout="default"
  footnoteSize="lg"
  image="/images/gallery/10.jpg"
  paragraphs={[
    'Every corner of Horizons is composed for atmosphere: soft ocean breezes, candlelight, and a soundscape that moves from sunset acoustic to midnight energy.',
    'Reserve your table by the water, settle into a private cabana, or let our hosts craft an evening that belongs only to you.',
  ]}
>
  <p
    class="text-contrast max-w-xs text-center text-[10px] font-medium tracking-[0.35em] text-sunset-yellow uppercase md:max-w-sm md:text-xs"
  >
    Golden hour on Eagle Beach
  </p>
</SectionWrapper>
