---
/**
 * 8. Footer — elegant, minimal wrap-up with legal info and Amsterdam Manor synergy.
 */
---

<footer id="footer" class="snap-section flex items-center justify-center bg-cream">
  <div class="px-6 text-center">
    <img
      src="/images/horizons-logo.svg"
      alt="Horizons Lounge Aruba"
      class="mx-auto w-56 opacity-90"
      loading="lazy"
    />
    <p class="mt-8 text-[11px] font-medium tracking-[0.2em] text-warm-charcoal/70 uppercase">
      Amsterdam Manor Beach Resort · J.E. Irausquin Blvd 252, Eagle Beach, Aruba
    </p>
    <p class="mt-3 text-[11px] font-medium tracking-[0.2em] text-warm-charcoal/50 uppercase">
      © {new Date().getFullYear()} Horizons Lounge Aruba — All rights reserved
    </p>
  </div>
</footer>
