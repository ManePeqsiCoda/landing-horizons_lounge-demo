---
/**
 * Footer — teal-night block: giant typographic CTA with circle link,
 * newsletter, four hairline columns, bottom bar.
 * Client-pending data (WhatsApp, socials, legal) degrades to spans.
 */
import { RESERVE_PATH, EMAIL, EMAIL_HREF, SOCIAL, LEGAL } from '../data/contact';

const isTodo = (v: string) => v === 'TODO_CLIENTE';
const year = new Date().getFullYear();
---

<footer class="site-footer horizon-motif horizon-motif--on-dark">
  <div class="page-pad">
    <div class="site-footer__cta">
      <h2 class="site-footer__title display-copy" data-reveal>
        Reserve your <span class="indent">Evening</span>
      </h2>
      <a href={RESERVE_PATH} class="site-footer__circle" aria-label="Reserve a table at Horizons Lounge" data-reveal>
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M9 7h8v8" />
        </svg>
      </a>
    </div>

    <div class="site-footer__grid">
      <div class="site-footer__news">
        <h3 class="site-footer__label">Stay in the loop</h3>
        <p>Sunset hours, live music nights and seasonal menus — once a month, never more.</p>
        <form class="site-footer__news-form" data-newsletter novalidate>
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input id="newsletter-email" type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
          <button type="submit">Join</button>
        </form>
        <div class="site-footer__social">
          {Object.values(SOCIAL).map((s) =>
            isTodo(s.href) ? (
              <span aria-label={`${s.label} (link pending)`} title="Link pending from client">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                </svg>
              </span>
            ) : (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                </svg>
              </a>
            ),
          )}
        </div>
      </div>

      <nav aria-label="Footer">
        <h3 class="site-footer__label">Explore</h3>
        <ul class="site-footer__list">
          <li><a href="/">Home</a></li>
          <li><a href="/menu">Menu</a></li>
          <li><a href="/experiences">Experiences</a></li>
          <li><a href="/gallery">Gallery</a></li>
          <li><a href={RESERVE_PATH}>Reserve</a></li>
        </ul>
      </nav>

      <div>
        <h3 class="site-footer__label">Visit</h3>
        <ul class="site-footer__list">
          <li><span>J.E. Irausquin Blvd 252</span></li>
          <li><span>Eagle Beach, Aruba</span></li>
          <li><a href={EMAIL_HREF}>{EMAIL}</a></li>
          <li>
            <a href="https://www.amsterdammanor.com" target="_blank" rel="noopener noreferrer">
              Amsterdam Manor Resort ↗
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="site-footer__label">Hours</h3>
        <ul class="site-footer__list">
          <li><span>Sunset Ritual · daily at dusk</span></li>
          <li><span>Happy Hour · 5:30–6:30 PM</span></li>
          <li><span>Happy Hour · 9:00–10:00 PM</span></li>
          <li><a href="/admin">Team access</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {year} Horizons Lounge · Amsterdam Manor Beach Resort</span>
      <span style="display: inline-flex; gap: 1.5rem;">
        {Object.values(LEGAL).map((l) =>
          isTodo(l.href) ? <span>{l.label}</span> : <a href={l.href}>{l.label}</a>,
        )}
      </span>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = form.querySelector('input');
      if (input && !input.checkValidity()) {
        input.focus();
        return;
      }
      form.innerHTML = '<p style="color: var(--color-sunflower); font-weight: 600; margin: 0;">You are on the list ✦ See you at sunset.</p>';
    });
  });
</script>
