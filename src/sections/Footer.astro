---
/**
 * 8. Footer — full-featured professional footer for Horizons Lounge Aruba.
 * Uses the horizon logo SVG, layered navigation, contact details, social
 * links and a newsletter CTA. Built with the same luxury restraint as the
 * rest of the experience.
 */
import {
  EMAIL,
  EMAIL_HREF,
  LEGAL,
  PHONE_DISPLAY,
  PHONE_HREF,
  RESERVE_PATH,
  WHATSAPP_URL,
} from '../data/contact';

const currentYear = new Date().getFullYear();

const exploreLinks = [
  { label: 'Home', href: '/' },
  { label: 'The Ritual', href: '/#ritual' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Culinary & Mixology', href: '/menu' },
  { label: 'Experiences', href: '/experiences' },
  { label: 'Reserve', href: RESERVE_PATH, accent: true },
];

const visitLinks = [
  { label: 'Amsterdam Manor Beach Resort', href: 'https://www.amsterdammanor.com', external: true },
  { label: 'J.E. Irausquin Blvd 252, Eagle Beach, Aruba', href: 'https://maps.google.com/?q=Amsterdam+Manor+Aruba', external: true },
  { label: EMAIL, href: EMAIL_HREF },
  { label: PHONE_DISPLAY, href: PHONE_HREF },
  { label: 'WhatsApp us', href: WHATSAPP_URL, external: true },
];

const hours = [
  { day: 'Sunset Ritual', time: 'Daily — 5:00 PM' },
  { day: 'Kitchen', time: '6:00 PM – 11:00 PM' },
  { day: 'Late Night', time: 'Fri & Sat — 1:00 AM' },
];

const legalLinks = [LEGAL.privacy, LEGAL.terms, LEGAL.accessibility];
---

<footer id="footer" class="snap-section relative overflow-hidden bg-night">
  {/* Subtle horizon gradient texture behind the content */}
  <div
    class="absolute inset-0 bg-gradient-to-t from-warm-charcoal/30 via-night to-night"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 flex h-full flex-col justify-between px-6 py-12 md:px-12 lg:px-20">
    {/* Top: centered logo and tagline */}
    <div class="flex flex-col items-center justify-center pt-4 md:pt-8">
      <a href="/" aria-label="Horizons Lounge Aruba" class="w-44 md:w-56 lg:w-64">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 500 160"
          width="100%"
          height="auto"
          class="select-none"
          aria-label="Horizons Lounge"
        >
          <defs>
            <radialGradient id="footer-sun-gradient" cx="35%" cy="35%" r="65%">
              <stop offset="0%" stop-color="#FFF000" />
              <stop offset="60%" stop-color="#FFCC00" />
              <stop offset="100%" stop-color="#FFA500" />
            </radialGradient>

            <mask id="footer-top-mask">
              <rect width="500" height="160" fill="white" />
              <path d="M 20,88 Q 250,70 480,98 L 480,160 L 20,160 Z" fill="black" />
            </mask>

            <mask id="footer-bottom-mask">
              <rect width="500" height="160" fill="black" />
              <path d="M 20,88 Q 250,70 480,98 L 480,160 L 20,160 Z" fill="white" />
            </mask>
          </defs>

          <circle cx="395" cy="75" r="42" fill="url(#footer-sun-gradient)" />

          <g mask="url(#footer-top-mask)">
            <text
              x="250"
              y="85"
              font-family="'Outfit', ui-sans-serif, system-ui, sans-serif"
              font-size="46"
              font-weight="300"
              letter-spacing="9"
              fill="#fdf8f1"
              text-anchor="middle"
            >
              HORIZONS
            </text>
          </g>

          <path
            d="M 30,88 Q 250,70 470,98"
            stroke="#fdf8f1"
            stroke-width="1.5"
            fill="none"
            stroke-linecap="round"
          />

          <g mask="url(#footer-bottom-mask)" transform="translate(0, 168) scale(1, -1)">
            <text
              x="250"
              y="85"
              font-family="'Outfit', ui-sans-serif, system-ui, sans-serif"
              font-size="46"
              font-weight="300"
              letter-spacing="9"
              fill="#00B4D8"
              text-anchor="middle"
            >
              HORIZONS
            </text>
          </g>
        </svg>
      </a>
      <p class="mt-4 text-center text-[10px] font-medium tracking-[0.3em] text-cream/60 uppercase">
        Sunset Ritual · Eagle Beach · Aruba
      </p>
    </div>

    {/* Middle: four-column grid */}
    <div class="mt-10 grid gap-10 border-t border-white/10 pt-10 md:mt-14 md:grid-cols-2 lg:grid-cols-4 md:pt-14">
      {/* Column 1: About + Social */}
      <div>
        <h3 class="mb-4 text-[10px] font-semibold tracking-[0.25em] text-sunset-yellow uppercase">
          The Experience
        </h3>
        <p class="mb-6 max-w-xs text-sm font-light leading-relaxed text-cream/80">
          A curated sunset ritual where craft cocktails, island cuisine and live music meet the horizon of Eagle Beach.
        </p>
        <div class="flex items-center gap-4">
          <span
            class="text-cream/70"
            title="Instagram — TODO_CLIENTE"
            aria-label="Instagram (pending client handle)"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </span>
          <span
            class="text-cream/70"
            title="Facebook — TODO_CLIENTE"
            aria-label="Facebook (pending client handle)"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </span>
          <span
            class="text-cream/70"
            title="TikTok — TODO_CLIENTE"
            aria-label="TikTok (pending client handle)"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
          </span>
        </div>
      </div>

      {/* Column 2: Explore */}
      <div>
        <h3 class="mb-4 text-[10px] font-semibold tracking-[0.25em] text-sunset-yellow uppercase">
          Explore
        </h3>
        <ul class="flex flex-col gap-2">
          {
            exploreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={`text-sm font-light tracking-wide transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night ${
                    link.accent ? 'text-sunset-yellow hover:text-white' : 'text-cream/80 hover:text-sunset-yellow'
                  }`}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Column 3: Visit */}
      <div>
        <h3 class="mb-4 text-[10px] font-semibold tracking-[0.25em] text-sunset-yellow uppercase">
          Visit
        </h3>
        <ul class="flex flex-col gap-2">
          {
            visitLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-sm font-light tracking-wide text-cream/80 transition-colors duration-300 hover:text-sunset-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-6">
          <h4 class="mb-2 text-[10px] font-semibold tracking-[0.25em] text-cream/50 uppercase">
            Hours
          </h4>
          <ul class="flex flex-col gap-1">
            {
              hours.map((h) => (
                <li class="flex justify-between gap-4 text-sm font-light text-cream/70">
                  <span>{h.day}</span>
                  <span>{h.time}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {/* Column 4: Newsletter + CTA */}
      <div>
        <h3 class="mb-4 text-[10px] font-semibold tracking-[0.25em] text-sunset-yellow uppercase">
          Stay in the loop
        </h3>
        <p class="mb-4 text-sm font-light leading-relaxed text-cream/80">
          Be the first to know about themed nights, sunset specials and private events.
        </p>
        <form
          class="flex flex-col gap-2"
          onsubmit="event.preventDefault();"
          aria-label="Newsletter signup"
        >
          <input
            type="email"
            placeholder="Your email"
            class="form-glass w-full border-white/20 bg-white/5 px-4 py-3 text-sm text-cream placeholder:text-cream/40 focus:border-sunset-yellow"
            required
          />
          <button
            type="submit"
            class="w-full border border-sunset-yellow bg-transparent px-4 py-3 text-xs font-semibold tracking-[0.2em] text-sunset-yellow uppercase transition-colors duration-300 hover:bg-sunset-yellow hover:text-night focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
          >
            Subscribe
          </button>
        </form>
        <a
          href={RESERVE_PATH}
          class="mt-5 inline-block text-xs font-semibold tracking-[0.2em] text-cream/90 uppercase transition-colors duration-300 hover:text-sunset-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
        >
          Book a table →
        </a>
        <button
          type="button"
          data-opentable-demo
          aria-label="Book on OpenTable (demo notice)"
          class="mt-3 block text-[10px] font-semibold tracking-[0.2em] text-cream/60 uppercase transition-colors duration-300 hover:text-sunset-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
        >
          Or book on OpenTable
        </button>
      </div>
    </div>

    {/* Bottom: legal bar */}
    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-[10px] font-medium tracking-[0.18em] text-cream/50 uppercase md:flex-row md:gap-6">
      <p>
        © {currentYear} Horizons Lounge Aruba — All rights reserved
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
        {
          legalLinks.map((link) =>
            link.href === 'TODO_CLIENTE' ? (
              <span title="TODO_CLIENTE — pending legal copy" class="cursor-default opacity-70">
                {link.label}
              </span>
            ) : (
              <a
                href={link.href}
                class="transition-colors duration-300 hover:text-sunset-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
              >
                {link.label}
              </a>
            )
          )
        }
      </div>
      <p>
        Part of Amsterdam Manor Beach Resort
      </p>
    </div>
  </div>
</footer>
