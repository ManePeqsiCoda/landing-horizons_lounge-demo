---
import SplitTitle from '../components/SplitTitle.astro';
import Reveal from '../components/Reveal';
import StoryImage from '../components/StoryImage';

const beats = [
  { label: 'Live', detail: 'Musicians as the sun drops', image: '/images/gallery/09.jpg' },
  { label: 'Crowd', detail: 'The magnetic social stage', image: '/images/gallery/04.jpg' },
  { label: 'Late', detail: 'Stay for the scene', image: '/images/gallery/08.jpg' },
];
---

<!-- Social Vibe — three photographic beats, staggered into night -->
<section
  id="events"
  class="story-section ritual-phase-dusk relative bg-night py-24 md:py-32 lg:py-40"
  data-ritual-phase="dusk"
>
  <div class="mx-auto max-w-7xl px-5 md:px-10 lg:px-16">
    <Reveal client:visible y={20} className="max-w-3xl">
      <SplitTitle base="SOCIAL" script="Vibe" />
    </Reveal>
    <Reveal client:visible delay={0.1} y={16} className="mt-8 max-w-2xl">
      <p class="text-on-photo font-light">
        When the sun sets, the rhythm rises. Come for the sunset, stay for the scene — from intimate conversations to late-night energy on Eagle Beach.
      </p>
    </Reveal>

    <div class="mt-14 grid gap-4 sm:grid-cols-3 md:mt-20 md:gap-5" aria-label="Social rhythm">
      {
        beats.map((beat, i) => (
          <Reveal client:visible delay={0.12 + i * 0.1} y={28} scale={0.97}>
            <article class="group relative aspect-[3/4] overflow-hidden">
              <StoryImage
                client:visible
                src={beat.image}
                className="absolute inset-0 h-full w-full"
                fromScale={1.1}
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-night via-night/40 to-ocean/20"
                aria-hidden="true"
              />
              <div class="absolute inset-x-0 bottom-0 p-5 md:p-6">
                <p class="font-serif text-3xl text-cream md:text-4xl">{beat.label}</p>
                <p class="mt-2 text-[10px] tracking-[0.2em] text-cream/70 uppercase">{beat.detail}</p>
              </div>
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
