---
/**
 * Part of Amsterdam Manor — full teal block (mirror of Amsterdam's blue
 * Direct section): mega headline, hairline perks, sunflower CTA.
 */
import { RESERVE_PATH } from '../data/contact';

const PERKS = [
  {
    name: 'Beachfront on Eagle Beach',
    detail: 'The lounge sits atop Amsterdam Manor Beach Resort, steps from the sand.',
  },
  {
    name: 'Priority terrace seating',
    detail: 'Resort guests are first in line for golden-hour tables.',
  },
  {
    name: 'Charge it to your room',
    detail: 'Cocktails, dinner and events settle straight into your stay.',
  },
  {
    name: 'The sunset, twice a day',
    detail: 'Two daily Happy Hours mean the ritual fits any itinerary.',
  },
];
---

<section class="hotel horizon-motif horizon-motif--on-dark" aria-labelledby="hotel-title">
  <div class="page-pad hotel__grid">
    <div>
      <p class="section-label" data-reveal style="color: var(--color-sunflower);">Part of Amsterdam Manor</p>
      <h2 class="hotel__title display-copy" id="hotel-title" data-split>
        Stay where the sunset lives
      </h2>
      <div class="hotel__cta" data-reveal>
        <a href={RESERVE_PATH} class="btn btn--sun">Reserve a table</a>
        <a
          href="https://www.amsterdammanor.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hotel__link"
        >
          Explore the resort ↗
        </a>
      </div>
    </div>

    <div class="hotel__perks" data-reveal-stagger>
      {PERKS.map((perk) => (
        <div class="hotel__perk" data-reveal-item>
          <h3 class="hotel__perk-name">{perk.name}</h3>
          <p class="hotel__perk-detail">{perk.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
