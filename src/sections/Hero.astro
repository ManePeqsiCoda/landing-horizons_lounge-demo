---
/**
 * 1. Landing Hero — future 4K sunset video with Fofoti tree silhouette.
 * No menu visible here; StickyMenu fades in after this frame.
 */
---

<section id="hero" class="snap-section flex items-center justify-center">
  <!-- Temporary monochrome placeholder (replaced by the 4K sunset video) -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-neutral-700 via-neutral-900 to-black grayscale"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 px-6 text-center">
    <p
      class="text-contrast mb-6 text-xs font-medium tracking-[0.45em] text-sunset-yellow uppercase"
    >
      Amsterdam Manor · Eagle Beach · Aruba
    </p>
    <h1
      class="text-contrast font-serif text-6xl font-medium tracking-wide text-white md:text-8xl"
    >
      HORIZONS
    </h1>
    <p
      class="text-contrast mt-6 text-sm font-light tracking-[0.3em] text-neutral-300 uppercase"
    >
      The Sunset Ritual
    </p>
  </div>

  <!-- Scroll cue -->
  <div
    class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-center"
    aria-hidden="true"
  >
    <p class="text-contrast text-[10px] tracking-[0.3em] text-neutral-400 uppercase">
      Scroll
    </p>
    <div class="mx-auto mt-2 h-10 w-px bg-gradient-to-b from-white/70 to-transparent">
    </div>
  </div>
</section>
