---
import SplitTitle from '../components/SplitTitle.astro';
import Reveal from '../components/Reveal';
---

<!-- Hero — full-bleed cinematic start; continuous scroll (not a locked slide) -->
<section
  id="hero"
  class="story-section relative flex min-h-[100svh] flex-col justify-between overflow-hidden"
>
  <video
    id="hero-video"
    src="/cinematic.mp4"
    poster="/images/sunset.png"
    muted
    playsinline
    preload="metadata"
    tabindex="-1"
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover"
  >
  </video>

  <div
    class="absolute inset-0 bg-gradient-to-b from-night/40 via-peach/10 to-night/70"
    aria-hidden="true"
  />
  <div
    class="ritual-horizon pointer-events-none absolute inset-x-0 top-[44%] z-[1] h-px opacity-50"
    aria-hidden="true"
  />

  <div class="relative z-10 p-4 pt-10 md:p-12 md:pt-20 lg:p-16 lg:pt-24">
    <SplitTitle base="HORIZONS" script="Lounge" />
  </div>

  <div class="relative z-10 flex flex-1 items-end px-5 pb-16 md:px-12 md:pb-20 lg:px-16 lg:pb-24">
    <Reveal client:visible y={20} className="max-w-xl">
      <p class="text-on-photo text-on-photo-lg font-light">
        Eagle Beach golden hour — handcrafted cocktails, curated rhythms, and the warmth of Aruba.
      </p>
      <p
        class="mt-8 text-[10px] tracking-[0.3em] text-cream/70 uppercase"
        aria-hidden="true"
      >
        Scroll to enter the ritual
      </p>
    </Reveal>
  </div>
</section>

<script is:inline>
  (function () {
    var video = document.getElementById('hero-video');
    if (!video) return;

    function startPlayback() {
      video.currentTime = 0;
      var playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(function () {});
      }
    }

    var loader = document.getElementById('horizons-loader');
    if (!loader) {
      startPlayback();
      return;
    }

    var observer = new MutationObserver(function () {
      if (!document.getElementById('horizons-loader')) {
        observer.disconnect();
        startPlayback();
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>
