---
/**
 * Home hero — full-bleed cinematic video, 2-line display headline,
 * lead on the right, scroll cue, and the reservation bar docked at the
 * bottom (Amsterdam Manor booking-bar grammar).
 */
import { RESERVE_PATH } from '../data/contact';

const times = ['5:00 PM', '5:30 PM', '6:00 PM', '6:30 PM', '7:00 PM', '7:30 PM', '8:00 PM', '8:30 PM', '9:00 PM', '9:30 PM', '10:00 PM'];
const today = new Date().toISOString().slice(0, 10);
---

<section class="hero" aria-label="Horizons Lounge — the Sunset Ritual">
  <div class="hero__media">
    <video
      autoplay
      muted
      loop
      playsinline
      poster="/images/sunset.png"
      data-parallax
      aria-hidden="true"
    >
      <source src="/cinematic.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__inner page-pad">
    <h1 class="hero__title">
      <span class="hero__title-line" data-hero-line><span>The Sunset</span></span>
      <span class="hero__title-line hero__title-line--indent" data-hero-line><span>Ritual</span></span>
    </h1>
    <div class="hero__side">
      <p class="hero__lead" data-hero-fade>
        Signature cocktails, island culinary and live energy on Eagle Beach —
        every evening, twice the golden hour.
      </p>
      <a href="#ritual" class="btn btn--ghost-light" data-hero-fade>Discover the evening</a>
    </div>
  </div>

  <span class="hero__cue" aria-hidden="true">Scroll</span>

  <div class="reserve-bar" data-hero-fade>
    <form class="reserve-bar__form" action={RESERVE_PATH} method="get" aria-label="Quick reservation">
      <label class="reserve-bar__field">
        <span class="reserve-bar__label">Date</span>
        <input type="date" name="date" min={today} value={today} required />
      </label>
      <label class="reserve-bar__field">
        <span class="reserve-bar__label">Time</span>
        <select name="time">
          {times.map((t) => <option value={t} selected={t === '5:30 PM'}>{t}</option>)}
        </select>
      </label>
      <label class="reserve-bar__field">
        <span class="reserve-bar__label">Guests</span>
        <select name="guests">
          {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option value={n} selected={n === 2}>{n} {n === 1 ? 'guest' : 'guests'}</option>)}
        </select>
      </label>
      <button type="submit" class="reserve-bar__submit">
        Reserve a table
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M9 7h8v8" />
        </svg>
      </button>
    </form>
  </div>
</section>
