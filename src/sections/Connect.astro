---
import SectionWrapper from '../components/SectionWrapper.astro';
---

<!-- 7. Connect (Direct/Indirect Channels) -->
<SectionWrapper id="connect" title="Reserve With Us" kicker="OpenTable · WhatsApp" tone="b">
  <div class="mt-8 flex flex-col items-center gap-4">
    <a
      href="#"
      class="text-contrast border border-sunset-yellow px-10 py-3 text-xs font-medium tracking-[0.35em] text-sunset-yellow uppercase transition-colors hover:bg-sunset-yellow hover:text-night"
    >
      Book on OpenTable
    </a>
    <a
      href="#"
      class="text-contrast text-xs font-light tracking-[0.3em] text-neutral-300 uppercase transition-colors hover:text-white"
    >
      WhatsApp us
    </a>
  </div>
</SectionWrapper>
