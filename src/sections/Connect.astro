---
import SplitTitle from '../components/SplitTitle.astro';
import Reveal from '../components/Reveal';
import StoryImage from '../components/StoryImage';
import { RESERVE_PATH, WHATSAPP_URL } from '../data/contact';
---

<!-- Reserve — night conversion, clear CTA hierarchy -->
<section
  id="connect"
  class="story-section ritual-phase-night relative min-h-[80vh] overflow-hidden"
  data-ritual-phase="night"
>
  <div class="absolute inset-0">
    <StoryImage
      client:visible
      src="/images/gallery/04.jpg"
      className="h-full w-full"
      fromScale={1.08}
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-night/75 via-warm-charcoal/50 to-night/95"
      aria-hidden="true"
    />
  </div>

  <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-start px-5 py-24 md:items-center md:px-10 md:py-32 md:text-center lg:py-40">
    <Reveal client:visible y={22}>
      <SplitTitle base="RESERVE" script="Now" />
    </Reveal>
    <Reveal client:visible delay={0.1} y={16} className="mt-8 max-w-2xl space-y-4">
      <p class="text-on-photo font-light">
        Securing your place at Horizons is effortless. Choose your moment — a sunset toast, a private dinner, a celebration — and let our team handle every detail.
      </p>
      <p class="text-on-photo font-light">
        Book through our reservation desk for a curated evening, or reach us on WhatsApp for a personal touch.
      </p>
    </Reveal>
    <Reveal client:visible delay={0.18} y={18} className="mt-12 flex w-full max-w-md flex-col items-stretch gap-4 md:items-center">
      <a
        href={RESERVE_PATH}
        class="border border-sunset-yellow bg-sunset-yellow px-10 py-4 text-center text-xs font-semibold tracking-[0.25em] text-night uppercase transition-colors hover:bg-cream focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
      >
        Reserve a table
      </a>
      <button
        type="button"
        data-opentable-demo
        aria-label="Book on OpenTable (demo notice)"
        class="border border-cream/40 px-10 py-3 text-xs font-semibold tracking-[0.25em] text-cream uppercase transition-colors hover:border-sunset-yellow hover:text-sunset-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
      >
        Book on OpenTable
      </button>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contact Horizons on WhatsApp"
        class="text-center text-xs font-semibold tracking-[0.2em] text-cream/80 uppercase transition-colors hover:text-sunset-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
      >
        WhatsApp us
      </a>
    </Reveal>
  </div>
</section>
