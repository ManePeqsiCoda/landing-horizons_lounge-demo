---
/**
 * Social — full-bleed photograph with dusk scrim, copy at the bottom
 * (mirror of Amsterdam's Celebrate section).
 */
---

<section class="social" aria-labelledby="social-title">
  <div class="social__media">
    <img
      src="/images/gallery/04.jpg"
      alt="Guests toasting cocktails while a saxophone player performs at sunset"
      loading="lazy"
      decoding="async"
      data-parallax
    />
  </div>
  <div class="social__shade" aria-hidden="true"></div>
  <div class="social__inner page-pad">
    <div>
      <p class="section-label" data-reveal style="color: var(--color-amber-light);">The Social Vibe</p>
      <h2 class="social__title display-copy" id="social-title" data-split>
        Where strangers become sunset friends
      </h2>
    </div>
    <p class="social__copy lead-copy" data-reveal>
      Live acoustic sets, shared platters, and a terrace that hums long after
      the sun goes down. Come for the horizon; stay for the company.
    </p>
  </div>
</section>
