---
import Loader from '../components/Loader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  reel?: boolean;
  robots?: string;
}

const {
  title = 'Horizons Lounge Aruba — Sunset Ritual',
  description = 'Horizons Lounge at Amsterdam Manor, Aruba. Signature cocktails, sushi, live music and the most iconic sunset ritual on Eagle Beach.',
  image = '/images/horizons-logo.svg',
  reel = false,
  robots = 'index, follow',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en" {...reel ? { 'data-reel': '' } : {}}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/images/horizons-logo.svg" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Horizons Lounge Aruba" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- LCP: preload brand asset -->
    <link rel="preload" as="image" href="/images/horizons-logo.svg" />
  </head>
  <body>
    <Loader />
    <slot />
  </body>
</html>
