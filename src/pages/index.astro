---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ReservePill from '../components/ReservePill.astro';
import Hero from '../sections/Hero.astro';
import Ritual from '../sections/Ritual.astro';
import Culinary from '../sections/Culinary.astro';
import Nights from '../sections/Nights.astro';
import Social from '../sections/Social.astro';
import Hotel from '../sections/Hotel.astro';
import Mosaic from '../sections/Mosaic.astro';
import Footer from '../sections/Footer.astro';
---

<Layout>
  <Header pathname={Astro.url.pathname} media />
  <ReservePill />
  <main id="main">
    <Hero />
    <Ritual />
    <Culinary />
    <Nights />
    <Social />
    <Hotel />
    <Mosaic />
  </main>
  <Footer />
</Layout>
