---
import Layout from '../layouts/Layout.astro';
import StickyMenu from '../components/StickyMenu';
import ReserveSticky from '../components/ReserveSticky';
import Hero from '../sections/Hero.astro';
import Ritual from '../sections/Ritual.astro';
import Experience from '../sections/Experience.astro';
import Culinary from '../sections/Culinary.astro';
import LiquidGold from '../sections/LiquidGold.astro';
import SocialVibe from '../sections/SocialVibe.astro';
import Connect from '../sections/Connect.astro';
import Footer from '../sections/Footer.astro';
---

<!-- Continuous-scroll home — Sunset Ritual storytelling (not reel / snap slides) -->
<Layout>
  <link
    rel="preload"
    as="image"
    href="/images/sunset.png"
    slot="head"
  />
  <StickyMenu client:load pathname={Astro.url.pathname} />
  <ReserveSticky client:load homeReel />
  <main id="home-main">
    <Hero />
    <Ritual />
    <Experience />
    <Culinary />
    <LiquidGold />
    <SocialVibe />
    <Connect />
    <Footer />
  </main>
</Layout>
