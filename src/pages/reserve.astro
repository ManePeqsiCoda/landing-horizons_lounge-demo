---
import Layout from '../layouts/Layout.astro';
import StickyMenu from '../components/StickyMenu';
import ReservationForm from '../components/reservation/ReservationForm';
import {
  DEPOSIT_AMOUNT,
  DEPOSIT_CURRENCY,
  STRIPE_PUBLISHABLE_KEY_ENV,
} from '../data/reservation';

const title = 'Reserve Your Sunset Table — Horizons Lounge Aruba';
const description =
  'Book your rooftop table at Horizons Lounge Aruba. Reserve your spot for the Sunset Ritual, live music nights, or Fajita Fridays with a simple $25 deposit.';
const image = '/images/drinks/signature-cocktail.jpg';

const stripePublishableKey =
  (import.meta.env as Record<string, string | undefined>)[STRIPE_PUBLISHABLE_KEY_ENV] ?? '';

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Reservation',
  name: 'Horizons Lounge Table Reservation',
  description,
  url: canonicalURL.href,
  image: new URL(image, Astro.url.origin).href,
  reservationFor: {
    '@type': 'Event',
    name: 'Horizons Lounge Rooftop Experience',
    location: {
      '@type': 'Place',
      name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'J.E. Irausquin Blvd 252',
        addressLocality: 'Eagle Beach',
        addressCountry: 'AW',
      },
    },
  },
  price: `${DEPOSIT_AMOUNT}`,
  priceCurrency: DEPOSIT_CURRENCY,
};
---

<Layout title={title} description={description} image={image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <StickyMenu client:load pathname={Astro.url.pathname} />

  <main
    id="reserve-main"
    class="reserve-stage relative min-h-screen overflow-x-hidden bg-night text-cream"
  >
    {/* Atmospheric background — blur stays on this layer only, never on form content */}
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="reserve-bg-blur absolute inset-0 scale-110 bg-cover bg-center bg-no-repeat" />
      <div class="reserve-vignette absolute inset-0" />
      <div class="reserve-light-leak absolute inset-0" />
      <div class="reserve-grain absolute inset-0 opacity-40" />
    </div>

    {/* Content */}
    <div class="reserve-content relative z-10 flex min-h-screen flex-col justify-start px-5 pt-28 pb-12 md:px-10 md:pt-32 lg:px-16 lg:pt-36">
      <div class="mx-auto w-full max-w-7xl">
        <header class="mb-8 max-w-2xl md:mb-10">
          <h1 class="font-serif text-[clamp(2.5rem,5vw,3.75rem)] font-bold tracking-tight text-cream">
            Reserve your table
          </h1>
          <p class="mt-3 text-on-photo font-light">
            Book directly with Horizons, or continue with OpenTable when the integration ships.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="#reserve-form"
              class="inline-flex border border-sunset-yellow bg-sunset-yellow px-6 py-3 text-[10px] font-semibold tracking-[0.2em] text-night uppercase transition-colors hover:bg-cream focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
            >
              Reserve with us
            </a>
            <button
              type="button"
              data-opentable-demo
              aria-label="Book on OpenTable (demo notice)"
              class="inline-flex border border-cream/35 bg-night/40 px-6 py-3 text-[10px] font-semibold tracking-[0.2em] text-cream uppercase backdrop-blur-sm transition-colors hover:border-sunset-yellow hover:text-sunset-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
            >
              Reserve with OpenTable
            </button>
          </div>
        </header>

        <div id="reserve-form" class="reserve-form-panel scroll-mt-28">
          <ReservationForm stripePublishableKey={stripePublishableKey} client:load />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .reserve-stage {
    background-color: var(--color-night);
  }

  .reserve-bg-blur {
    background-image: url('/images/sunset.png');
    background-size: cover;
    background-position: center;
    filter: blur(28px) saturate(1.15) brightness(0.55);
    transform: scale(1.12);
    /* Isolate filter so it cannot affect the form stacking context */
    isolation: isolate;
    will-change: transform;
  }

  .reserve-vignette {
    background:
      radial-gradient(circle at 20% 30%, rgba(255, 122, 69, 0.14) 0%, transparent 45%),
      radial-gradient(circle at 80% 70%, rgba(199, 91, 57, 0.1) 0%, transparent 40%),
      linear-gradient(135deg, rgba(11, 11, 15, 0.78) 0%, rgba(43, 36, 32, 0.62) 50%, rgba(11, 11, 15, 0.88) 100%);
  }

  .reserve-light-leak {
    background: radial-gradient(
      ellipse at 70% 20%,
      rgba(255, 215, 0, 0.1) 0%,
      rgba(255, 122, 69, 0.05) 25%,
      transparent 55%
    );
    mix-blend-mode: screen;
  }

  .reserve-grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .reserve-form-panel {
    background: var(--color-night);
    border: 1px solid rgba(253, 248, 241, 0.22);
    border-radius: 0;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    padding: 1.5rem;
    color: var(--color-cream);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  @media (min-width: 768px) {
    .reserve-form-panel {
      padding: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .reserve-form-panel {
      padding: 3rem;
    }
  }

  .reserve-label {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .reserve-label {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
    }
  }

  .reserve-label-text {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(253, 248, 241, 0.85);
  }

  @media (min-width: 768px) {
    .reserve-label-text {
      min-width: 8.5rem;
    }
  }

  .reserve-control {
    width: 100%;
  }

  @media (min-width: 768px) {
    .reserve-control {
      flex: 1 1 0%;
      width: auto;
    }
  }

  .reserve-input,
  .reserve-select {
    width: 100%;
    min-height: 3.5rem;
    height: 3.5rem;
    appearance: none;
    background: rgba(253, 248, 241, 0.1);
    border: 1px solid rgba(253, 248, 241, 0.28);
    border-radius: 0;
    color: #fdf8f1;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    padding: 0 1rem;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  textarea.reserve-input {
    height: auto;
    min-height: 5.5rem;
    padding: 0.875rem 1rem;
    line-height: 1.5;
    resize: vertical;
  }

  .reserve-input::placeholder {
    color: rgba(253, 248, 241, 0.45);
  }

  .reserve-input:hover,
  .reserve-select:hover {
    background: rgba(253, 248, 241, 0.14);
    border-color: rgba(253, 248, 241, 0.4);
  }

  .reserve-input:focus,
  .reserve-select:focus {
    background: rgba(253, 248, 241, 0.16);
    border-color: var(--color-sunset-orange);
    box-shadow: 0 0 0 3px rgba(255, 122, 69, 0.22);
  }

  .reserve-select {
    color-scheme: dark;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23fdf8f1' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 1rem center;
    background-repeat: no-repeat;
    background-size: 1.25rem;
    padding-right: 2.75rem;
  }

  .reserve-select-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    height: 3.5rem;
    appearance: none;
    background: rgba(253, 248, 241, 0.1);
    border: 1px solid rgba(253, 248, 241, 0.28);
    border-radius: 0;
    color: #fdf8f1;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    padding: 0 1rem;
    outline: none;
    text-align: left;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  .reserve-select-trigger:hover {
    background: rgba(253, 248, 241, 0.14);
    border-color: rgba(253, 248, 241, 0.4);
  }

  .reserve-select-trigger:focus-visible {
    background: rgba(253, 248, 241, 0.16);
    border-color: var(--color-sunset-orange);
    box-shadow: 0 0 0 3px rgba(255, 122, 69, 0.22);
  }

  .reserve-select-trigger[aria-expanded="true"] {
    border-color: var(--color-sunset-orange);
  }

  .reserve-input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(1);
    opacity: 0.6;
    cursor: pointer;
  }

  .reserve-card-element {
    padding: 0.25rem 0;
  }

  .reserve-stepper-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    background: rgba(253, 248, 241, 0.1);
    border: 1px solid rgba(253, 248, 241, 0.28);
    border-radius: 0;
    color: #fdf8f1;
    transition: border-color 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }

  .reserve-stepper-btn:hover:not(:disabled) {
    background: rgba(253, 248, 241, 0.16);
    border-color: var(--color-sunset-orange);
    color: var(--color-sunset-yellow);
  }

  .reserve-stepper-btn:focus-visible {
    outline: 2px solid var(--color-sunset-yellow);
    outline-offset: 2px;
  }

  .reserve-stepper-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .reserve-stepper-value {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: textfield;
    width: 100%;
    height: 3.5rem;
    text-align: center;
    background: rgba(253, 248, 241, 0.08);
    border-top: 1px solid rgba(253, 248, 241, 0.28);
    border-bottom: 1px solid rgba(253, 248, 241, 0.28);
    border-left: none;
    border-right: none;
    color: #fdf8f1;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    outline: none;
  }

  .reserve-stepper-value::-webkit-outer-spin-button,
  .reserve-stepper-value::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .reserve-submit-button {
    width: 100%;
    border-radius: 0;
    background: var(--color-sunset-yellow);
    border: 1px solid var(--color-sunset-yellow);
    color: var(--color-night);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 1.15rem 2rem;
    box-shadow: 0 10px 32px rgba(255, 215, 0, 0.22);
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
    cursor: pointer;
  }

  .reserve-submit-button:hover:not(:disabled) {
    transform: translateY(-2px);
    background: var(--color-cream);
    border-color: var(--color-cream);
  }

  .reserve-submit-button:focus-visible {
    outline: 2px solid var(--color-sunset-yellow);
    outline-offset: 3px;
  }

  .reserve-submit-button:disabled {
    opacity: 0.4;
    background: color-mix(in srgb, var(--color-warm-charcoal) 80%, transparent);
    border-color: color-mix(in srgb, var(--color-cream) 15%, transparent);
    color: color-mix(in srgb, var(--color-cream) 45%, transparent);
    box-shadow: none;
    cursor: not-allowed;
    transform: none;
  }
</style>
