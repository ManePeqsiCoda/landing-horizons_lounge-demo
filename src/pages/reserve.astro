---
import Layout from '../layouts/Layout.astro';
import StickyMenu from '../components/StickyMenu';
import ReservationForm from '../components/reservation/ReservationForm';
import {
  DEPOSIT_AMOUNT,
  DEPOSIT_CURRENCY,
  STRIPE_PUBLISHABLE_KEY_ENV,
} from '../data/reservation';

const title = 'Reserve Your Sunset Table — Horizons Lounge Aruba';
const description =
  'Book your rooftop table at Horizons Lounge Aruba. Reserve your spot for the Sunset Ritual, live music nights, or Fajita Fridays with a simple $25 deposit.';
const image = '/images/drinks/signature-cocktail.jpg';

const stripePublishableKey =
  (import.meta.env as Record<string, string | undefined>)[STRIPE_PUBLISHABLE_KEY_ENV] ?? '';

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Reservation',
  name: 'Horizons Lounge Table Reservation',
  description,
  url: canonicalURL.href,
  image: new URL(image, Astro.url.origin).href,
  reservationFor: {
    '@type': 'Event',
    name: 'Horizons Lounge Rooftop Experience',
    location: {
      '@type': 'Place',
      name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'J.E. Irausquin Blvd 252',
        addressLocality: 'Eagle Beach',
        addressCountry: 'AW',
      },
    },
  },
  price: `${DEPOSIT_AMOUNT}`,
  priceCurrency: DEPOSIT_CURRENCY,
};
---

<Layout title={title} description={description} image={image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <StickyMenu client:load pathname={Astro.url.pathname} />

  <main
    class="reserve-stage relative min-h-screen overflow-hidden bg-night text-cream"
    style="background-image: url('/images/sunset.png');"
  >
    {/* Deep atmospheric blur layers */}
    <div class="reserve-bg-blur absolute inset-0 scale-110 bg-cover bg-center bg-no-repeat" aria-hidden="true" />
    <div class="reserve-vignette absolute inset-0" aria-hidden="true" />
    <div class="reserve-light-leak absolute inset-0" aria-hidden="true" />
    <div class="reserve-grain absolute inset-0 opacity-40" aria-hidden="true" />

    {/* Content */}
    <div class="reserve-content relative z-10 flex min-h-screen flex-col justify-start px-5 pt-28 pb-12 md:px-10 md:pt-32 lg:px-16 lg:pt-36">
      <div class="mx-auto w-full max-w-7xl">
        <div class="reserve-form-panel">
          <ReservationForm stripePublishableKey={stripePublishableKey} client:load />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .reserve-stage {
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }

  .reserve-bg-blur {
    background-image: url('/images/sunset.png');
    filter: blur(28px) saturate(1.15) brightness(0.85);
    transform: scale(1.12);
  }

  .reserve-vignette {
    background:
      radial-gradient(circle at 20% 30%, rgba(255, 122, 69, 0.18) 0%, transparent 45%),
      radial-gradient(circle at 80% 70%, rgba(199, 91, 57, 0.14) 0%, transparent 40%),
      linear-gradient(135deg, rgba(11, 11, 15, 0.72) 0%, rgba(43, 36, 32, 0.55) 50%, rgba(11, 11, 15, 0.78) 100%);
  }

  .reserve-light-leak {
    background: radial-gradient(
      ellipse at 70% 20%,
      rgba(255, 215, 0, 0.12) 0%,
      rgba(255, 122, 69, 0.06) 25%,
      transparent 55%
    );
    mix-blend-mode: screen;
  }

  .reserve-grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .reserve-kicker {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-sunset-orange);
  }

  .reserve-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-cream);
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
  }

  .reserve-lead {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.65;
    color: rgba(253, 248, 241, 0.72);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .reserve-form-panel {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(32px) saturate(160%);
    -webkit-backdrop-filter: blur(32px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 1.5rem;
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .reserve-form-panel {
      padding: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .reserve-form-panel {
      padding: 3rem;
    }
  }

  .reserve-label {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .reserve-label {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
    }
  }

  .reserve-label-text {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(253, 248, 241, 0.65);
  }

  @media (min-width: 768px) {
    .reserve-label-text {
      min-width: 8.5rem;
    }
  }

  .reserve-control {
    width: 100%;
  }

  @media (min-width: 768px) {
    .reserve-control {
      flex: 1 1 0%;
      width: auto;
    }
  }

  .reserve-input,
  .reserve-select {
    width: 100%;
    height: 3.5rem;
    appearance: none;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.875rem;
    color: #fdf8f1;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    padding: 0 1rem;
    outline: none;
    transition: all 0.2s ease;
  }

  .reserve-input::placeholder {
    color: rgba(253, 248, 241, 0.35);
  }

  .reserve-input:hover,
  .reserve-select:hover {
    background: rgba(255, 255, 255, 0.11);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .reserve-input:focus,
  .reserve-select:focus {
    background: rgba(255, 255, 255, 0.14);
    border-color: var(--color-sunset-orange);
    box-shadow: 0 0 0 3px rgba(255, 122, 69, 0.18);
  }

  .reserve-select {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23fdf8f1' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 1rem center;
    background-repeat: no-repeat;
    background-size: 1.25rem;
    padding-right: 2.75rem;
  }

  .reserve-input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(1);
    opacity: 0.6;
    cursor: pointer;
  }

  .reserve-card-element {
    padding: 0.25rem 0;
  }

  .reserve-stepper-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fdf8f1;
    transition: all 0.18s ease;
  }

  .reserve-stepper-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.14);
    border-color: var(--color-sunset-orange);
    color: var(--color-sunset-yellow);
  }

  .reserve-stepper-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .reserve-stepper-value {
    appearance: none;
    width: 100%;
    height: 3.5rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.05);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    border-left: none;
    border-right: none;
    color: #fdf8f1;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    outline: none;
  }

  .reserve-stepper-value::-webkit-outer-spin-button,
  .reserve-stepper-value::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .reserve-submit-button {
    width: 100%;
    border-radius: 9999px;
    background: var(--color-sunset-yellow);
    border: 1px solid var(--color-sunset-yellow);
    color: var(--color-warm-charcoal);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 1.125rem 2rem;
    box-shadow:
      0 8px 24px rgba(255, 215, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.45);
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .reserve-submit-button:hover:not(:disabled) {
    transform: translateY(-2px);
    background: #fff;
    border-color: #fff;
    box-shadow:
      0 14px 36px rgba(255, 215, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .reserve-submit-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>
