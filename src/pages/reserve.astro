---
import Layout from '../layouts/Layout.astro';
import StickyMenu from '../components/StickyMenu';
import ReservationForm from '../components/reservation/ReservationForm';
import {
  DEPOSIT_AMOUNT,
  DEPOSIT_CURRENCY,
  STRIPE_PUBLISHABLE_KEY_ENV,
} from '../data/reservation';

const title = 'Reserve Your Sunset Table — Horizons Lounge Aruba';
const description =
  'Book your rooftop table at Horizons Lounge Aruba. Reserve your spot for the Sunset Ritual, live music nights, or Fajita Fridays with a simple $25 deposit.';
const image = '/images/drinks/signature-cocktail.jpg';

const stripePublishableKey =
  (import.meta.env as Record<string, string | undefined>)[STRIPE_PUBLISHABLE_KEY_ENV] ?? '';

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Reservation',
  name: 'Horizons Lounge Table Reservation',
  description,
  url: canonicalURL.href,
  image: new URL(image, Astro.url.origin).href,
  reservationFor: {
    '@type': 'Event',
    name: 'Horizons Lounge Rooftop Experience',
    location: {
      '@type': 'Place',
      name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'J.E. Irausquin Blvd 252',
        addressLocality: 'Eagle Beach',
        addressCountry: 'AW',
      },
    },
  },
  price: `${DEPOSIT_AMOUNT}`,
  priceCurrency: DEPOSIT_CURRENCY,
};
---

<Layout title={title} description={description} image={image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <StickyMenu client:load pathname={Astro.url.pathname} />

  <main
    class="relative flex min-h-screen bg-sand bg-cover bg-center bg-no-repeat text-warm-charcoal"
    style="background-image: url('/images/sunset.png');"
  >
    {/* Atmospheric overlays for depth and readability */}
    <div class="absolute inset-0 bg-gradient-to-br from-night/50 via-warm-charcoal/25 to-night/45" />
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,transparent_0%,rgba(11,11,15,0.25)_100%)]" />

    {/* Left liquid-glass reservation panel */}
    <section
      class="glass-panel-light relative z-10 flex min-h-screen w-full flex-col justify-center border-r border-warm-charcoal/10 px-6 py-10 shadow-2xl backdrop-blur-2xl lg:w-[68%] lg:px-8 lg:py-12 xl:w-[70%] xl:px-10"
    >
      {/* Header */}
      <header class="mb-5 lg:mb-6">
        <p class="mb-1.5 text-xs font-semibold tracking-[0.25em] text-terracotta uppercase">
          Rooftop Reservations
        </p>
        <h1 class="font-display text-4xl font-semibold leading-[0.95] tracking-tight text-warm-charcoal md:text-5xl lg:text-[3rem]">
          Reserve Your Sunset
        </h1>
        <p class="mt-2 max-w-md text-base font-light leading-relaxed text-warm-charcoal/70">
          Choose your experience, pick your golden-hour table, and secure it with a small demo
          deposit.
        </p>
      </header>

      <ReservationForm stripePublishableKey={stripePublishableKey} client:load />
    </section>
  </main>
</Layout>
