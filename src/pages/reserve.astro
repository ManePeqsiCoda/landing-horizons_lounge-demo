---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../sections/Footer.astro';
import ReservationForm from '../components/reservation/ReservationForm';
import {
  DEPOSIT_AMOUNT,
  DEPOSIT_CURRENCY,
  STRIPE_PUBLISHABLE_KEY_ENV,
} from '../data/reservation';

const title = 'Reserve Your Sunset Table — Horizons Lounge Aruba';
const description =
  'Book your rooftop table at Horizons Lounge Aruba. Reserve your spot for the Sunset Ritual, live music nights, or Fajita Fridays with a simple $25 deposit.';
const image = '/images/drinks/signature-cocktail.jpg';

const stripePublishableKey =
  (import.meta.env as Record<string, string | undefined>)[STRIPE_PUBLISHABLE_KEY_ENV] ?? '';

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Reservation',
  name: 'Horizons Lounge Table Reservation',
  description,
  url: canonicalURL.href,
  image: new URL(image, Astro.url.origin).href,
  reservationFor: {
    '@type': 'Event',
    name: 'Horizons Lounge Rooftop Experience',
    location: {
      '@type': 'Place',
      name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'J.E. Irausquin Blvd 252',
        addressLocality: 'Eagle Beach',
        addressCountry: 'AW',
      },
    },
  },
  price: `${DEPOSIT_AMOUNT}`,
  priceCurrency: DEPOSIT_CURRENCY,
};
---

<Layout title={title} description={description} image={image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Header pathname={Astro.url.pathname} />

  <main id="main" class="reserve-main page-pad">
    <div class="reserve-layout">
      <aside class="reserve-aside">
        <p class="section-label" data-reveal>Reservations</p>
        <h1 class="reserve-aside__title display-copy" data-split>Reserve your table</h1>
        <p class="reserve-aside__lead lead-copy" data-reveal>
          Book directly with Horizons — a ${DEPOSIT_AMOUNT} deposit holds your
          table and comes off your evening's bill.
        </p>

        <dl class="reserve-aside__facts" data-reveal>
          <div class="reserve-aside__fact">
            <dt>Deposit</dt>
            <dd>${DEPOSIT_AMOUNT} {DEPOSIT_CURRENCY} · credited to your bill</dd>
          </div>
          <div class="reserve-aside__fact">
            <dt>Happy Hour</dt>
            <dd>5:30–6:30 PM &amp; 9:00–10:00 PM</dd>
          </div>
          <div class="reserve-aside__fact">
            <dt>Find us</dt>
            <dd>J.E. Irausquin Blvd 252, Eagle Beach</dd>
          </div>
          <div class="reserve-aside__fact">
            <dt>Questions</dt>
            <dd><a href="mailto:reservations@horizonsaruba.com" style="color: inherit;">reservations@horizonsaruba.com</a></dd>
          </div>
        </dl>
      </aside>

      <div class="reserve-form-panel" id="reserve-form" data-reveal>
        <ReservationForm stripePublishableKey={stripePublishableKey} client:load />
      </div>
    </div>
  </main>

  <Footer />
</Layout>
