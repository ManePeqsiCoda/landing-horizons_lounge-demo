---
import Layout from '../layouts/Layout.astro';
import StickyMenu from '../components/StickyMenu';
import ReserveSticky from '../components/ReserveSticky';
import Events from '../sections/Events.astro';
import Footer from '../sections/Footer.astro';

const title = 'Experiences & Events — Horizons Lounge Aruba';
const description =
  'Discover the signature experiences at Horizons Lounge Aruba. The daily Sunset Ritual, the Manager’s Cocktail Party, and Fajita Fridays — all set against the golden light of Eagle Beach.';
const image = '/images/drinks/signature-cocktail.jpg';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: [
    {
      '@type': 'Event',
      name: 'The Sunset Ritual',
      description:
        'Daily sunset gathering at Horizons Lounge with signature cocktails and Eagle Beach views.',
      image: new URL('/images/drinks/tropical-mixology.jpg', Astro.url.origin)
        .href,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'J.E. Irausquin Blvd 252',
          addressLocality: 'Eagle Beach',
          addressCountry: 'AW',
        },
      },
      startDate: '2026-08-01T18:00:00-04:00',
    },
    {
      '@type': 'Event',
      name: "Manager's Cocktail Party",
      description:
        'An open-air evening of live music, curated cocktails, and the Social Vibe of Horizons Lounge.',
      image: new URL('/images/drinks/signature-cocktail.jpg', Astro.url.origin)
        .href,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'J.E. Irausquin Blvd 252',
          addressLocality: 'Eagle Beach',
          addressCountry: 'AW',
        },
      },
      startDate: '2026-08-07T19:00:00-04:00',
    },
    {
      '@type': 'Event',
      name: 'Fajita Fridays',
      description:
        'A fun, casual all-you-can-eat fajita night and the perfect start to the weekend at Horizons Lounge.',
      image: new URL('/images/drinks/happy-hour.jpg', Astro.url.origin).href,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'J.E. Irausquin Blvd 252',
          addressLocality: 'Eagle Beach',
          addressCountry: 'AW',
        },
      },
      startDate: '2026-08-07T18:30:00-04:00',
    },
  ],
};
---

<Layout title={title} description={description} image={image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <StickyMenu client:load pathname={Astro.url.pathname} />
  <ReserveSticky client:load />

  <main class="experiences-stage relative min-h-screen overflow-hidden bg-night text-cream">
    {/* Dark blurred background from existing gallery image */}
    <div class="experiences-bg absolute inset-0 bg-cover bg-center bg-no-repeat" aria-hidden="true" />
    <div class="experiences-overlay absolute inset-0" aria-hidden="true" />
    <div class="experiences-grain absolute inset-0" aria-hidden="true" />

    {/* Page header */}
    <section class="experiences-header relative z-10 px-6 pb-10 pt-32 md:pt-40 lg:pb-16 lg:pt-48">
      <div class="mx-auto max-w-6xl text-center">
        <p class="experiences-kicker">Sun-kissed Gatherings</p>
        <h1 class="experiences-title mt-4">
          <span class="block">Experiences</span>
          <span class="experiences-title-accent">& Events</span>
        </h1>
        <p class="experiences-lead mx-auto mt-6 max-w-2xl">
          Three ways to meet the Aruba sunset — from the quiet magic of the daily ritual to the
          lively hum of Fajita Fridays. Each experience is designed around the horizon, good
          company, and the signature yellow glow of golden hour.
        </p>
      </div>
    </section>

    <Events />
  </main>

  <Footer />
</Layout>

<style>
  .experiences-stage {
    background-color: var(--color-night);
  }

  .experiences-bg {
    background-image: url('/images/gallery/02.jpg');
    filter: blur(22px) saturate(1.1) brightness(0.45);
    transform: scale(1.12);
  }

  .experiences-overlay {
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 122, 69, 0.12) 0%, transparent 40%),
      radial-gradient(circle at 80% 80%, rgba(199, 91, 57, 0.1) 0%, transparent 45%),
      linear-gradient(180deg, rgba(11, 11, 15, 0.82) 0%, rgba(11, 11, 15, 0.92) 60%, var(--color-night) 100%);
  }

  .experiences-grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.35'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
    opacity: 0.35;
    pointer-events: none;
  }

  .experiences-kicker {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-sunset-orange);
  }

  .experiences-title {
    font-family: var(--font-serif);
    font-size: clamp(3.25rem, 8vw, 6.5rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--color-cream);
    text-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
  }

  .experiences-title-accent {
    font-family: var(--font-perfect-girl);
    font-size: 0.55em;
    font-weight: 400;
    color: var(--color-sunset-yellow);
    letter-spacing: 0.02em;
    display: inline-block;
    margin-top: 0.15em;
    transform: rotate(-2deg);
  }

  .experiences-lead {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.7;
    color: rgba(253, 248, 241, 0.65);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }
</style>
