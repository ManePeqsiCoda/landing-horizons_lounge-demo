---
import Layout from '../layouts/Layout.astro';
import StickyMenu from '../components/StickyMenu';
import Events from '../sections/Events.astro';
import Footer from '../sections/Footer.astro';

const title = 'Experiences & Events — Horizons Lounge Aruba';
const description =
  'Discover the signature experiences at Horizons Lounge Aruba. The daily Sunset Ritual, the Manager’s Cocktail Party, and Fajita Fridays — all set against the golden light of Eagle Beach.';
const image = '/images/drinks/signature-cocktail.jpg';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: [
    {
      '@type': 'Event',
      name: 'The Sunset Ritual',
      description:
        'Daily sunset gathering at Horizons Lounge with signature cocktails and Eagle Beach views.',
      image: new URL('/images/drinks/tropical-mixology.jpg', Astro.url.origin)
        .href,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'J.E. Irausquin Blvd 252',
          addressLocality: 'Eagle Beach',
          addressCountry: 'AW',
        },
      },
      startDate: '2026-08-01T18:00:00-04:00',
    },
    {
      '@type': 'Event',
      name: "Manager's Cocktail Party",
      description:
        'An open-air evening of live music, curated cocktails, and the Social Vibe of Horizons Lounge.',
      image: new URL('/images/drinks/signature-cocktail.jpg', Astro.url.origin)
        .href,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'J.E. Irausquin Blvd 252',
          addressLocality: 'Eagle Beach',
          addressCountry: 'AW',
        },
      },
      startDate: '2026-08-07T19:00:00-04:00',
    },
    {
      '@type': 'Event',
      name: 'Fajita Fridays',
      description:
        'A fun, casual all-you-can-eat fajita night and the perfect start to the weekend at Horizons Lounge.',
      image: new URL('/images/drinks/happy-hour.jpg', Astro.url.origin).href,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'J.E. Irausquin Blvd 252',
          addressLocality: 'Eagle Beach',
          addressCountry: 'AW',
        },
      },
      startDate: '2026-08-07T18:30:00-04:00',
    },
  ],
};
---

<Layout title={title} description={description} image={image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <StickyMenu client:load pathname={Astro.url.pathname} />

  <main class="bg-cream text-warm-charcoal">
    <!-- Page header — magazine cover energy -->
    <section class="px-6 pb-8 pt-28 md:pt-32 lg:pb-12 lg:pt-40">
      <div class="mx-auto max-w-6xl text-center">
        <p
          class="mb-4 text-[11px] font-semibold tracking-[0.3em] text-terracotta uppercase"
        >
          Sun-kissed Gatherings
        </p>
        <h1 class="font-display text-5xl font-semibold tracking-tight text-warm-charcoal md:text-7xl lg:text-8xl">
          Experiences
        </h1>
        <p
          class="mx-auto mt-6 max-w-2xl text-sm font-light leading-relaxed text-warm-charcoal/70"
        >
          Three ways to meet the Aruba sunset — from the quiet magic of the
          daily ritual to the lively hum of Fajita Fridays. Each experience is
          designed around the horizon, good company, and the signature yellow
          glow of golden hour.
        </p>
      </div>
    </section>

    <Events />
  </main>

  <Footer />
</Layout>
