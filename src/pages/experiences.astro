---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../sections/Footer.astro';
import { EVENTS } from '../data/events';
import { RESERVE_PATH } from '../data/contact';

const title = 'Experiences & Events — Horizons Lounge Aruba';
const description =
  'Discover the signature experiences at Horizons Lounge Aruba. The daily Sunset Ritual, the Manager’s Cocktail Party, and Fajita Fridays — all set against the golden light of Eagle Beach.';
const image = '/images/drinks/signature-cocktail.jpg';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: EVENTS.map((event) => ({
    '@type': 'Event',
    name: event.title,
    description: event.description,
    image: new URL(event.image, Astro.url.origin).href,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'J.E. Irausquin Blvd 252',
        addressLocality: 'Eagle Beach',
        addressCountry: 'AW',
      },
    },
  })),
};

const when = (id: string) =>
  id === 'sunset-ritual' ? 'Daily · 6 PM' : 'Fridays';
---

<Layout title={title} description={description} image={image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Header pathname={Astro.url.pathname} />
  <main id="main">
    <section class="interior-hero page-pad">
      <p class="section-label" data-reveal>Experiences &amp; Events</p>
      <h1 class="interior-hero__title display-copy" data-split>Three ways to meet the sunset</h1>
      <p class="interior-hero__lead lead-copy" data-reveal>
        From the quiet magic of the daily ritual to the lively hum of Fajita
        Fridays — each experience is designed around the horizon, good company,
        and the signature glow of golden hour.
      </p>
      <div class="interior-hero__meta" data-reveal>
        <span>Happy Hour <strong>5:30–6:30 PM</strong> &amp; <strong>9:00–10:00 PM</strong></span>
        <span>Eagle Beach · Amsterdam Manor</span>
      </div>
    </section>

    <section class="page-pad" style="padding-bottom: clamp(4rem, 8vw, 7rem);" aria-label="Experiences list">
      <div class="xp-list" data-reveal-stagger>
        {EVENTS.map((event, i) => (
          <article class:list={['xp-item', i === 0 && 'is-open']} id={event.id} data-reveal-item>
            <button
              type="button"
              class="xp-item__row"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`xp-panel-${event.id}`}
              data-xp-toggle
            >
              <span class="xp-item__when">{when(event.id)}</span>
              <h2 class="xp-item__name">{event.title}</h2>
              <span class="xp-item__kicker">{event.kicker}</span>
              <span class="xp-item__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </button>
            <div class="xp-item__panel" id={`xp-panel-${event.id}`}>
              <div class="xp-item__panel-inner">
                <div class="xp-item__panel-grid">
                  <div class="xp-item__media" data-image-reveal>
                    <img src={event.image} alt={event.imageAlt} loading="lazy" decoding="async" />
                  </div>
                  <div>
                    <p class="xp-item__desc">{event.description}</p>
                    <ul class="xp-item__details">
                      {event.details.map((d) => <li>{d}</li>)}
                    </ul>
                    <a href={event.ctaHref} class="btn btn--pine">{event.cta}</a>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Closing CTA — sunflower block */}
    <section class="page-pad" style="padding-bottom: clamp(5rem, 9vw, 8rem);">
      <div class="hh-block horizon-motif" data-reveal>
        <div>
          <p class="section-label">Make an evening yours</p>
          <h2 class="hh-block__title display-copy">The horizon keeps your seat</h2>
        </div>
        <p style="margin: 0; color: rgba(13,43,39,0.82); font-size: var(--text-body-lg); max-width: 24rem;">
          Reserve for the Sunset Ritual, a Manager’s Cocktail Party, or Fajita
          Fridays — your table on Eagle Beach awaits.
        </p>
        <div style="display: flex; align-items: center;">
          <a href={RESERVE_PATH} class="btn btn--pine">Reserve a table</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-xp-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.xp-item');
        if (!item) return;
        const open = item.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
      });
    });
    // Deep links (#event-id) open their accordion row.
    if (window.location.hash) {
      const target = document.querySelector(window.location.hash);
      if (target?.classList.contains('xp-item')) {
        target.classList.add('is-open');
        target.querySelector('[data-xp-toggle]')?.setAttribute('aria-expanded', 'true');
      }
    }
  </script>
</Layout>
