---
import Layout from '../layouts/Layout.astro';
import StickyMenu from '../components/StickyMenu';
import ReserveSticky from '../components/ReserveSticky';
import Reveal from '../components/Reveal';
import StoryImage from '../components/StoryImage';
import EventCarousel from '../components/EventCarousel';
import Events from '../sections/Events.astro';
import Footer from '../sections/Footer.astro';
import { EVENT_CAROUSEL } from '../data/events';

const title = 'Experiences & Events — Horizons Lounge Aruba';
const description =
  'Discover the signature experiences at Horizons Lounge Aruba. The daily Sunset Ritual, the Manager’s Cocktail Party, and Fajita Fridays — all set against the golden light of Eagle Beach.';
const image = '/images/drinks/signature-cocktail.jpg';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: [
    {
      '@type': 'Event',
      name: 'The Sunset Ritual',
      description:
        'Daily sunset gathering at Horizons Lounge with signature cocktails and Eagle Beach views.',
      image: new URL('/images/drinks/tropical-mixology.jpg', Astro.url.origin).href,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'J.E. Irausquin Blvd 252',
          addressLocality: 'Eagle Beach',
          addressCountry: 'AW',
        },
      },
      startDate: '2026-08-01T18:00:00-04:00',
    },
    {
      '@type': 'Event',
      name: "Manager's Cocktail Party",
      description:
        'An open-air evening of live music, curated cocktails, and the Social Vibe of Horizons Lounge.',
      image: new URL('/images/drinks/signature-cocktail.jpg', Astro.url.origin).href,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'J.E. Irausquin Blvd 252',
          addressLocality: 'Eagle Beach',
          addressCountry: 'AW',
        },
      },
      startDate: '2026-08-07T19:00:00-04:00',
    },
    {
      '@type': 'Event',
      name: 'Fajita Fridays',
      description:
        'A fun, casual all-you-can-eat fajita night and the perfect start to the weekend at Horizons Lounge.',
      image: new URL('/images/drinks/happy-hour.jpg', Astro.url.origin).href,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Horizons Lounge at Amsterdam Manor Beach Resort',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'J.E. Irausquin Blvd 252',
          addressLocality: 'Eagle Beach',
          addressCountry: 'AW',
        },
      },
      startDate: '2026-08-07T18:30:00-04:00',
    },
  ],
};
---

<Layout title={title} description={description} image={image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <StickyMenu client:load pathname={Astro.url.pathname} />
  <ReserveSticky client:load />

  <main id="experiences-main" class="relative bg-night text-cream">
    {/* Hero — continuous scroll storytelling */}
    <section class="story-section relative min-h-[88vh] overflow-hidden">
      <div class="absolute inset-0">
        <StoryImage
          client:visible
          src="/images/gallery/09.jpg"
          className="h-full w-full"
          fromScale={1.16}
        />
        <div
          class="absolute inset-0 bg-gradient-to-b from-night/70 via-night/45 to-night"
          aria-hidden="true"
        />
        <div
          class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,rgba(255,122,69,0.18),transparent_50%)]"
          aria-hidden="true"
        />
      </div>

      <div class="relative z-10 mx-auto flex min-h-[88vh] max-w-5xl flex-col justify-end px-6 pb-20 pt-36 md:px-12 md:pb-28 lg:pb-32">
        <Reveal client:visible y={30}>
          <h1 class="font-serif text-[clamp(3.25rem,9vw,6.5rem)] font-bold leading-[0.92] tracking-[-0.03em] text-cream">
            Experiences
            <span
              class="mt-2 block font-normal text-sunset-yellow"
              style="font-family: var(--font-perfect-girl); font-size: 0.55em; transform: rotate(-2deg);"
            >
              & Events
            </span>
          </h1>
        </Reveal>
        <Reveal client:visible delay={0.12} y={22} className="mt-8 max-w-2xl">
          <p class="text-on-photo text-on-photo-lg font-light">
            Three ways to meet the Aruba sunset — from the quiet magic of the daily ritual to the
            lively hum of Fajita Fridays. Each experience is designed around the horizon, good
            company, and the signature yellow glow of golden hour.
          </p>
        </Reveal>
      </div>
    </section>

    <Events />

    <EventCarousel client:load slides={EVENT_CAROUSEL} />

    {/* Closing CTA band */}
    <section class="relative px-6 py-24 md:px-12 md:py-32">
      <Reveal client:visible y={20} className="mx-auto max-w-3xl text-center">
        <h2 class="font-serif text-3xl text-cream md:text-5xl">Make an evening yours</h2>
        <p class="mx-auto mt-5 max-w-xl text-on-photo font-light">
          Reserve for the Sunset Ritual, a Manager’s Cocktail Party, or Fajita Fridays — your table on Eagle Beach awaits.
        </p>
        <a
          href="/reserve"
          class="mt-10 inline-flex border border-sunset-yellow bg-sunset-yellow px-10 py-4 text-[10px] font-semibold tracking-[0.22em] text-night uppercase transition-colors hover:bg-cream focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
        >
          Reserve a table
        </a>
      </Reveal>
    </section>
  </main>

  <Footer />
</Layout>
