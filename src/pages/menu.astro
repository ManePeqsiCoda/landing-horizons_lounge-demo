---
import Layout from '../layouts/Layout.astro';
import StickyMenu from '../components/StickyMenu';
import MenuHero from '../components/MenuHero.astro';
import MenuContent from '../sections/MenuContent.astro';

const title = 'Culinary & Mixology — Horizons Lounge Aruba';
const description =
  'Explore the drinks and plates menu at Horizons Lounge Aruba. Signature cocktails, sushi, plant-based dishes and the sunset ritual at Amsterdam Manor.';
---

<Layout title={title} description={description}>
  <StickyMenu client:load />
  <main>
    <MenuHero />
    <MenuContent />
  </main>
</Layout>
