---
// Hero dividido: DRINKS (arriba-izquierda) y PLATES (abajo-derecha).
// En landscape la división es diagonal; en portrait es horizontal.
// Cada área es clickeable y hace scroll suave hacia #menu-content.
---

<section
  id="menu-hero"
  class="relative h-screen w-screen overflow-hidden bg-night"
  aria-label="Selecciona una categoría del menú"
>
  {/* DRINKS: mitad superior en portrait, triángulo superior-izquierdo en landscape */}
  <a
    href="#menu-content"
    class="menu-triangle drinks-area group absolute inset-0 z-10 flex items-start justify-start transition-colors duration-500 hover:bg-white/[0.03]"
    aria-label="Ver bebidas"
  >
    <div class="pointer-events-none p-10 md:p-20 lg:p-28">
      <span
        class="text-contrast font-serif text-5xl font-medium tracking-[0.08em] text-white transition-all duration-500 ease-out group-hover:tracking-[0.14em] md:text-6xl lg:text-7xl"
      >
        DRINKS
      </span>
    </div>
  </a>

  {/* PLATES: mitad inferior en portrait, triángulo inferior-derecho en landscape */}
  <a
    href="#menu-content"
    class="menu-triangle plates-area group absolute inset-0 z-10 flex items-end justify-end transition-colors duration-500 hover:bg-white/[0.03]"
    aria-label="Ver platillos"
  >
    <div class="pointer-events-none p-10 md:p-20 lg:p-28">
      <span
        class="text-contrast font-serif text-5xl font-medium tracking-[0.08em] text-white transition-all duration-500 ease-out group-hover:tracking-[0.14em] md:text-6xl lg:text-7xl"
      >
        PLATES
      </span>
    </div>
  </a>

  {/* Línea divisoria: diagonal en landscape, horizontal en portrait */}
  <div
    class="pointer-events-none absolute inset-0 z-20"
    aria-hidden="true"
  >
    <svg
      class="h-full w-full"
      preserveAspectRatio="none"
      viewBox="0 0 100 100"
      xmlns="http://www.w3.org/2000/svg"
    >
      <line
        class="divider-diagonal"
        x1="100"
        y1="0"
        x2="0"
        y2="100"
        stroke="rgba(255, 255, 255, 0.22)"
        stroke-width="0.18"
      />
      <line
        class="divider-horizontal"
        x1="0"
        y1="50"
        x2="100"
        y2="50"
        stroke="rgba(255, 255, 255, 0.22)"
        stroke-width="0.18"
      />
    </svg>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.menu-triangle').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const target = document.getElementById('menu-content');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>

<style>
  .drinks-area {
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .plates-area {
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }
  .divider-horizontal {
    display: none;
  }

  @media (orientation: portrait) {
    .drinks-area {
      clip-path: polygon(0 0, 100% 0, 100% 50%, 0 50%);
    }
    .plates-area {
      clip-path: polygon(0 50%, 100% 50%, 100% 100%, 0 100%);
    }
    .divider-diagonal {
      display: none;
    }
    .divider-horizontal {
      display: block;
    }
  }
</style>
