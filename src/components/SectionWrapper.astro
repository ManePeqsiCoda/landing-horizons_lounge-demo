---
import SplitTitle from './SplitTitle.astro';
import SectionFootnote from './SectionFootnote.astro';

/**
 * Reel section wrapper with Sunset Ritual day→night phases.
 * Layout variants break the “same block every time” pattern for Culinary / Liquid Gold / Social.
 */
interface Props {
  id: string;
  base: string;
  script: string;
  paragraphs: string[];
  /** @deprecated Prefer `phase` — kept for Connect until migrated. */
  tone?: 'a' | 'b';
  image?: string;
  footnoteSize?: 'default' | 'lg';
  /**
   * Day→night narrative phase (Sunset Ritual tokens).
   * day → golden → dusk → night
   */
  phase?: 'day' | 'golden' | 'dusk' | 'night';
  /** Visual format — default lockup, split culinary, cocktail signatures, social rhythm. */
  layout?: 'default' | 'split' | 'signatures' | 'rhythm';
}

const {
  id,
  base,
  script,
  paragraphs,
  tone = 'a',
  image,
  footnoteSize = 'default',
  phase = tone === 'b' ? 'golden' : 'dusk',
  layout = 'default',
} = Astro.props;

const phaseOverlay: Record<NonNullable<Props['phase']>, string> = {
  day: 'from-sand/25 via-peach/15 to-warm-charcoal/55',
  golden: 'from-night/45 via-sunset-orange/20 to-night/65',
  dusk: 'from-night/55 via-ocean/25 to-night/75',
  night: 'from-night/75 via-warm-charcoal/45 to-night/90',
};

const phaseFallback: Record<NonNullable<Props['phase']>, string> = {
  day: 'from-sand/80 via-peach/40 to-warm-charcoal',
  golden: 'from-sunset-orange/50 via-terracotta/40 to-night',
  dusk: 'from-ocean/60 via-warm-charcoal/50 to-night',
  night: 'from-night via-warm-charcoal/80 to-night',
};

const isSplit = layout === 'split';
---

<section
  id={id}
  class:list={[
    'snap-section ritual-section relative flex h-svh min-h-svh flex-col justify-between overflow-hidden',
    `ritual-phase-${phase}`,
    `ritual-layout-${layout}`,
  ]}
  data-ritual-phase={phase}
>
  {
    image ? (
      <>
        <img
          src={image}
          alt=""
          loading="lazy"
          class:list={[
            'absolute inset-0 h-full w-full object-cover transition-[filter,transform] duration-700 ease-out',
            isSplit && 'md:w-[58%] md:right-0 md:left-auto',
          ]}
          aria-hidden="true"
        />
        <div
          class:list={[
            'absolute inset-0 bg-gradient-to-b transition-colors duration-700',
            phaseOverlay[phase],
            isSplit && 'md:bg-gradient-to-r md:from-night/90 md:via-night/55 md:to-transparent',
          ]}
          aria-hidden="true"
        />
        {/* Brand horizon accent line */}
        <div
          class="ritual-horizon pointer-events-none absolute inset-x-0 top-[42%] z-[1] h-px opacity-40"
          aria-hidden="true"
        />
      </>
    ) : (
      <div
        class={`absolute inset-0 bg-gradient-to-b ${phaseFallback[phase]}`}
        aria-hidden="true"
      />
    )
  }

  <div
    class:list={[
      'relative z-10 p-4 pt-10 md:p-12 md:pt-20 lg:p-16 lg:pt-24',
      isSplit && 'md:max-w-[48%]',
    ]}
  >
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-night/50 via-night/20 to-transparent"
      aria-hidden="true"
    />
    <SplitTitle base={base} script={script} />
  </div>

  <div
    class:list={[
      'relative z-10 flex min-h-0 flex-1 px-4 md:px-6',
      layout === 'default' && 'items-center justify-center',
      layout === 'split' && 'items-end justify-start pb-4 md:items-center md:pb-0',
      layout === 'signatures' && 'items-center justify-center md:justify-end',
      layout === 'rhythm' && 'items-center justify-center',
    ]}
  >
    <slot />
  </div>

  <SectionFootnote paragraphs={paragraphs} size={footnoteSize} />
</section>
