---
import SplitTitle from './SplitTitle.astro';
import SectionFootnote from './SectionFootnote.astro';

/**
 * Reel section wrapper: exactly 100vh x 100vw with scroll-snap lock.
 * Full-bleed photography background with a dark vignette overlay.
 *
 * Each section now uses a two-word typographic lockup on the left
 * (bold sans base + overlapped script) and a full-width narrative
 * footnote pinned to the bottom.
 */
interface Props {
  id: string;
  /** First word — large sans-serif base layer. */
  base: string;
  /** Second word — script layer overlapped to the right/bottom. */
  script: string;
  /** Two or more paragraphs shown at the bottom of the section. */
  paragraphs: string[];
  tone?: 'a' | 'b';
  image?: string;
  /** Footnote body size — `lg` for senior-friendly sections. */
  footnoteSize?: 'default' | 'lg';
}

const { id, base, script, paragraphs, tone = 'a', image, footnoteSize = 'default' } = Astro.props;

const overlayGradients = {
  a: 'from-night/65 via-warm-charcoal/25 to-night/75',
  b: 'from-night/60 via-terracotta/20 to-night/70',
};

const fallbackGradients = {
  a: 'from-night/85 via-warm-charcoal/65 to-night',
  b: 'from-warm-charcoal/85 via-terracotta/45 to-night',
};
---

<section id={id} class="snap-section relative flex h-svh min-h-svh flex-col justify-between overflow-hidden">
  {
    image ? (
      <>
        <img
          src={image}
          alt=""
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
          aria-hidden="true"
        />
        <div
          class={`absolute inset-0 bg-gradient-to-b ${overlayGradients[tone]}`}
          aria-hidden="true"
        />
      </>
    ) : (
      <div
        class={`absolute inset-0 bg-gradient-to-b ${fallbackGradients[tone]}`}
        aria-hidden="true"
      />
    )
  }

  {/* Top-left typographic lockup — local scrim for title contrast */}
  <div class="relative z-10 p-4 pt-10 md:p-12 md:pt-20 lg:p-16 lg:pt-24">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-night/50 via-night/20 to-transparent"
      aria-hidden="true"
    />
    <SplitTitle base={base} script={script} />
  </div>

  {/* Optional center content */}
  <div class="relative z-10 flex min-h-0 flex-1 items-center justify-center px-4 md:px-6">
    <slot />
  </div>

  {/* Full-width bottom narrative */}
  <SectionFootnote paragraphs={paragraphs} size={footnoteSize} />
</section>
