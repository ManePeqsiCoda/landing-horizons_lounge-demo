---
/**
 * Minimal brand loader: teal-night veil + horizon mark, 280ms fade.
 * Skipped on return navigations within the session and under reduced motion.
 */
---

<div id="horizons-loader" class="loader" role="status" aria-label="Loading Horizons Lounge" data-loader>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 200 120"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M8 78 H192" />
    <path d="M62 78 A38 38 0 0 1 138 78" />
    <path d="M100 22 V34" />
    <path d="M66 34 L74 44" />
    <path d="M134 34 L126 44" />
    <path d="M44 52 L56 58" />
    <path d="M156 52 L144 58" />
    <path d="M28 94 H112" />
    <path d="M132 94 H172" />
    <path d="M52 106 H148" />
  </svg>
</div>

<script is:inline>
  (function () {
    var loader = document.getElementById('horizons-loader');
    if (!loader) return;

    var SESSION_KEY = 'horizons-loader-seen';
    var reduceMotion = false;
    try {
      reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (e) {}

    var seen = false;
    try {
      seen = window.sessionStorage.getItem(SESSION_KEY) === '1';
    } catch (e) {}

    if (reduceMotion) {
      loader.remove();
      return;
    }

    function dismiss() {
      loader.classList.add('is-done');
      window.setTimeout(function () {
        if (loader && loader.parentNode) loader.remove();
      }, 320);
      try {
        window.sessionStorage.setItem(SESSION_KEY, '1');
      } catch (e) {}
    }

    window.setTimeout(dismiss, seen ? 120 : 600);
  })();
</script>
