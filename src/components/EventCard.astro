---
import type { EventItem } from '../data/events';
import Reveal from './Reveal';
import StoryImage from './StoryImage';

interface Props extends EventItem {}

const {
  image,
  imageAlt,
  title,
  description,
  details,
  date,
  dateKicker,
  cta,
  ctaHref,
  layout = 'media-right',
} = Astro.props;

const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const isImmersive = layout === 'immersive';
const mediaLeft = layout === 'media-left';
---

{
  isImmersive ? (
    <section
      id={slug}
      class="story-section relative min-h-[92vh] overflow-hidden"
      aria-labelledby={`event-title-${slug}`}
    >
      <div class="absolute inset-0">
        <StoryImage client:visible src={image} alt={imageAlt} className="h-full w-full" fromScale={1.14} />
        <div
          class="absolute inset-0 bg-gradient-to-r from-night via-night/70 to-night/35"
          aria-hidden="true"
        />
      </div>

      <div class="relative z-10 mx-auto flex min-h-[92vh] max-w-7xl flex-col justify-end px-6 py-20 md:px-12 md:py-28 lg:px-16">
        <Reveal client:visible y={28} className="max-w-xl">
          <p class="font-display text-xs font-semibold tracking-[0.28em] text-sunset-orange uppercase">
            {dateKicker} · {date}
          </p>
          <h2
            id={`event-title-${slug}`}
            class="mt-4 font-serif text-[clamp(2.75rem,6vw,4.75rem)] font-bold leading-[0.95] tracking-[-0.03em] text-cream"
          >
            {title}
          </h2>
        </Reveal>
        <Reveal client:visible delay={0.1} y={20} className="mt-6 max-w-lg">
          <p class="text-on-photo font-light">{description}</p>
        </Reveal>
        <Reveal client:visible delay={0.18} y={16} className="mt-6">
          <ul class="flex flex-wrap gap-2">
            {details.map((detail) => (
              <li class="border border-cream/20 bg-night/40 px-3 py-1.5 text-[10px] font-semibold tracking-[0.14em] text-cream/80 uppercase backdrop-blur-sm">
                {detail}
              </li>
            ))}
          </ul>
        </Reveal>
        <Reveal client:visible delay={0.24} y={14} className="mt-8">
          <a
            href={ctaHref}
            class="inline-flex border border-sunset-yellow bg-sunset-yellow px-8 py-3.5 text-[10px] font-semibold tracking-[0.22em] text-night uppercase transition-colors hover:bg-cream focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
          >
            {cta}
            <span aria-hidden="true" class="ml-2">→</span>
          </a>
        </Reveal>
      </div>
    </section>
  ) : (
    <section
      id={slug}
      class="story-section relative grid min-h-[85vh] grid-cols-1 overflow-hidden bg-night lg:grid-cols-2"
      aria-labelledby={`event-title-${slug}`}
    >
      <div
        class:list={[
          'relative min-h-[55vh] lg:min-h-full',
          mediaLeft ? 'lg:order-1' : 'lg:order-2',
        ]}
      >
        <StoryImage
          client:visible
          src={image}
          alt={imageAlt}
          className="absolute inset-0 h-full w-full"
          fromScale={1.12}
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-night/50 via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-night/40"
          aria-hidden="true"
        />
        <div class="absolute right-4 top-4 z-10 border border-cream/15 bg-night/55 px-4 py-3 text-center backdrop-blur-md md:right-8 md:top-8 md:px-5 md:py-4">
          <span class="block text-[10px] font-semibold tracking-[0.2em] text-sunset-orange uppercase">
            {dateKicker}
          </span>
          <span class="mt-1 block font-display text-3xl font-bold tracking-tight text-cream md:text-4xl">
            {date}
          </span>
        </div>
      </div>

      <div
        class:list={[
          'flex flex-col justify-center px-6 py-16 md:px-12 lg:px-16 lg:py-24',
          mediaLeft ? 'lg:order-2' : 'lg:order-1',
        ]}
      >
        <Reveal client:visible y={24}>
          <h2
            id={`event-title-${slug}`}
            class="font-serif text-[clamp(2.5rem,5vw,4.25rem)] font-bold leading-[0.95] tracking-[-0.03em] text-cream"
          >
            {title}
          </h2>
        </Reveal>
        <Reveal client:visible delay={0.1} y={18} className="mt-6 max-w-md">
          <p class="text-on-photo font-light">{description}</p>
        </Reveal>
        <Reveal client:visible delay={0.16} y={14} className="mt-6">
          <ul class="flex flex-wrap gap-2">
            {details.map((detail) => (
              <li class="border border-cream/15 px-3 py-1.5 text-[10px] font-semibold tracking-[0.14em] text-cream/75 uppercase">
                {detail}
              </li>
            ))}
          </ul>
        </Reveal>
        <Reveal client:visible delay={0.22} y={14} className="mt-8">
          <a
            href={ctaHref}
            class="inline-flex border border-sunset-yellow bg-sunset-yellow px-8 py-3.5 text-[10px] font-semibold tracking-[0.22em] text-night uppercase transition-colors hover:bg-cream focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sunset-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-night"
          >
            {cta}
            <span aria-hidden="true" class="ml-2">→</span>
          </a>
        </Reveal>
      </div>
    </section>
  )
}
