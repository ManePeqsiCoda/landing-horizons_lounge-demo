---
import type { EventItem } from '../data/events';

interface Props extends EventItem {}

const {
  image,
  imageAlt,
  kicker,
  title,
  description,
  details,
  date,
  dateKicker,
  cta,
  ctaHref,
} = Astro.props;

const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<section
  class="event-card group relative grid min-h-[90vh] grid-cols-1 lg:grid-cols-2"
  aria-labelledby={`event-title-${slug}`}
>
  <!-- Text panel — frosted glass over dark background -->
  <div
    class="event-text-panel order-2 flex flex-col justify-center px-8 py-16 transition-transform duration-500 ease-out group-hover:-translate-y-1 lg:order-1 lg:px-16 lg:py-24 xl:px-24"
  >
    <p class="event-kicker">{kicker}</p>
    <h2
      id={`event-title-${slug}`}
      class="event-title mt-3"
    >
      {title}
    </h2>

    <p class="event-description mt-6 max-w-md">
      {description}
    </p>

    <ul class="mt-6 flex flex-wrap gap-3">
      {
        details.map((detail) => (
          <li class="event-chip">{detail}</li>
        ))
      }
    </ul>

    <a href={ctaHref} class="event-cta mt-8">
      {cta}
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <!-- Image panel with date badge -->
  <div
    class="relative order-1 min-h-[60vh] overflow-hidden lg:order-2 lg:min-h-full"
  >
    <img
      src={image}
      alt={imageAlt}
      width="1200"
      height="1600"
      loading="lazy"
      class="event-image"
    />

    <div class="event-date-badge">
      <span class="event-date-kicker">{dateKicker}</span>
      <span class="event-date-main">{date}</span>
    </div>
  </div>
</section>

<style>
  .event-text-panel {
    background: rgba(11, 11, 15, 0.42);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 1024px) {
    .event-text-panel {
      border-right: none;
      border-left: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  .event-kicker {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-sunset-orange);
  }

  .event-title {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-cream);
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.35);
  }

  .event-description {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.7;
    color: rgba(253, 248, 241, 0.62);
  }

  .event-chip {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(253, 248, 241, 0.72);
    padding: 0.5rem 0.875rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    transition: all 0.25s ease;
  }

  .event-chip:hover {
    border-color: rgba(255, 122, 69, 0.45);
    color: var(--color-sunset-orange);
  }

  .event-cta {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.75rem;
    border-radius: 9999px;
    background: var(--color-sunset-yellow);
    border: 1px solid var(--color-sunset-yellow);
    color: var(--color-warm-charcoal);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 1rem 1.75rem;
    box-shadow:
      0 8px 24px rgba(255, 215, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transition: all 0.3s ease;
  }

  .event-cta:hover {
    transform: translateY(-3px);
    background: var(--color-cream);
    border-color: var(--color-cream);
    box-shadow:
      0 14px 36px rgba(255, 215, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.55);
  }

  .event-cta:focus-visible {
    outline: 2px solid var(--color-sunset-yellow);
    outline-offset: 3px;
  }

  .event-image {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: all 0.7s ease-out;
  }

  .event-card:hover .event-image {
    transform: scale(1.06);
    filter: saturate(1.15) brightness(1.05);
  }

  .event-date-badge {
    position: absolute;
    right: 1rem;
    top: 1rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: rgba(11, 11, 15, 0.55);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
  }

  @media (min-width: 768px) {
    .event-date-badge {
      right: 2rem;
      top: 2rem;
      padding: 1.25rem 1.75rem;
    }
  }

  .event-date-kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-sunset-orange);
  }

  .event-date-main {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-cream);
  }

  @media (min-width: 768px) {
    .event-date-main {
      font-size: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .event-date-main {
      font-size: 4rem;
    }
  }
</style>
