---
/**
 * Full-width bottom narrative block for landing sections.
 * Sans body + stronger scrim for contrast over photography.
 */
interface Props {
  /** One or more text fragments that will be joined into a single full-width paragraph. */
  paragraphs: string[];
  /** Larger body for senior-friendly sections (e.g. Experience). */
  size?: 'default' | 'lg';
}

const { paragraphs, size = 'default' } = Astro.props;
const fullText = paragraphs.join(' ');
const textClass = size === 'lg' ? 'text-on-photo text-on-photo-lg' : 'text-on-photo';
---

<div
  class="section-footnote relative z-10 w-full border-t border-white/10 bg-gradient-to-t from-night/90 via-night/65 to-transparent px-4 py-4 md:px-8 md:py-7 lg:px-12 lg:py-10"
>
  <p class={`w-full max-w-5xl font-light tracking-[0.02em] ${textClass}`}>
    {fullText}
  </p>
</div>
